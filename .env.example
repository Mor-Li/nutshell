# 复制成 .env 再填上自己的值。.env 不进 git。
# Copy to .env and fill in your own values. .env is gitignored.

# 终端版默认走的 OpenAI 兼容网关 / OpenAI-compatible gateway used by the terminal version
LITELLM_BASE_URL='https://api.openai.com/v1'
LITELLM_API_KEY='sk-...'

# 可选：/own 切过去用的 Google AI Studio key / optional key for /own
GEMINI_AI_STUDIO_KEY_NUTSHELL=''
